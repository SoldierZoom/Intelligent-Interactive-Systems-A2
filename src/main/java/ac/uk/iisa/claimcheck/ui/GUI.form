<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ac.uk.iisa.claimcheck.ui.GUI">
  <grid id="mainGrid" binding="mainPanel" layout-manager="GridLayoutManager" row-count="6" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="8">
    <margin top="22" left="24" bottom="22" right="24"/>
    <constraints>
      <xy x="20" y="20" width="720" height="620"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="titleLabel" class="javax.swing.JLabel" binding="titleLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="ClaimCheck"/>
        </properties>
      </component>
      <component id="subtitleLabel" class="javax.swing.JLabel" binding="subtitleLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Inspect the evidence behind an AI answer."/>
        </properties>
      </component>
      <grid id="inputPanel" binding="inputPanel" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="18" vgap="8">
        <margin top="8" left="0" bottom="8" right="0"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="inputLabel" class="javax.swing.JLabel" binding="inputLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="AI response to check"/>
            </properties>
          </component>
          <component id="sourcesLabel" class="javax.swing.JLabel" binding="sourcesLabel">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Source passages to check against *"/>
            </properties>
          </component>
          <scrollpane id="inputScrollPane">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <minimum-size width="280" height="220"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="inputTextArea" class="javax.swing.JTextArea" binding="inputTextArea">
                <constraints/>
                <properties>
                  <lineWrap value="true"/>
                  <wrapStyleWord value="true"/>
                </properties>
              </component>
            </children>
          </scrollpane>
          <scrollpane id="sourcesScrollPane">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <minimum-size width="280" height="220"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="sourcesTextArea" class="javax.swing.JTextArea" binding="sourcesTextArea">
                <constraints/>
                <properties>
                  <lineWrap value="true"/>
                  <wrapStyleWord value="true"/>
                </properties>
              </component>
            </children>
          </scrollpane>
        </children>
      </grid>
      <grid id="actionsPanel" binding="actionsPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="hintLabel" class="javax.swing.JLabel" binding="hintLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Paste an answer above to get started."/>
            </properties>
          </component>
          <component id="checkButton" class="javax.swing.JButton" binding="checkButton">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Check response"/>
            </properties>
          </component>
        </children>
      </grid>
      <component id="resultsLabel" class="javax.swing.JLabel" binding="resultsLabel">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Claim-by-claim review"/>
        </properties>
      </component>
      <scrollpane id="resultsScrollPane">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <minimum-size width="-1" height="200"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="resultsTextArea" class="javax.swing.JTextArea" binding="resultsTextArea">
            <constraints/>
            <properties>
              <editable value="false"/>
              <lineWrap value="true"/>
              <text value="Your claim-by-claim review will appear here."/>
              <wrapStyleWord value="true"/>
            </properties>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
